// Sap xep theo thu tu ngan sach giam dan 
void sapXep()
{
    for(int i=0; i<n-1; i++)
    {
        for (int j=i+1; j<n; j++)
        {
            if (ds[i].getNganSach() < ds[j].getNganSach())
            {
                DuAn t=ds[i];
                ds[i]=ds[j];
                ds[j]=t;
            }
        }
    }

    cout << "\nDa sap xep danh sach theo ngan sach giam dan!\n";
}
